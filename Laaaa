<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ahmed & Anhar | Wedding Invitation</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  min-height:100vh;
  font-family:Georgia,"Times New Roman",serif;
  color:white;
  background:
    radial-gradient(circle at 20% 15%,rgba(190,120,255,.25),transparent 25%),
    radial-gradient(circle at 80% 80%,rgba(130,70,180,.22),transparent 30%),
    linear-gradient(135deg,#10051d,#32104d,#12051d);
  display:flex;
  justify-content:center;
  align-items:center;
  overflow:hidden;
}

body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 15% 25%,#f4c98a 0 3px,transparent 5px),
    radial-gradient(circle at 30% 10%,#f4c98a 0 2px,transparent 4px),
    radial-gradient(circle at 50% 18%,#f4c98a 0 3px,transparent 5px),
    radial-gradient(circle at 72% 12%,#f4c98a 0 2px,transparent 4px),
    radial-gradient(circle at 88% 25%,#f4c98a 0 3px,transparent 5px),
    radial-gradient(circle at 10% 75%,#f4c98a 0 2px,transparent 4px),
    radial-gradient(circle at 90% 70%,#f4c98a 0 2px,transparent 4px);
  opacity:.8;
}

.card{
  width:92%;
  max-width:760px;
  text-align:center;
  padding:45px 20px 35px;
  border:1px solid rgba(244,201,149,.45);
  border-radius:25px;
  background:rgba(15,5,25,.55);
  backdrop-filter:blur(12px);
  box-shadow:0 25px 70px rgba(0,0,0,.5);
}

.kicker{
  font-size:16px;
  letter-spacing:5px;
  color:#efd8c2;
  margin-bottom:15px;
}

.names{
  direction:ltr;
  font-size:clamp(48px,10vw,88px);
  font-weight:400;
  color:#f4c998;
  line-height:1;
}

.names span{
  color:#fff;
  font-size:.55em;
  margin:0 8px;
}

.line{
  width:180px;
  height:1px;
  margin:25px auto;
  background:linear-gradient(
    to right,
    transparent,
    #eac28e,
    transparent
  );
}

.date{
  direction:ltr;
  font-size:clamp(20px,4vw,29px);
  color:#fff0df;
  margin-bottom:15px;
}

.venue{
  margin-bottom:30px;
}

.venue strong{
  display:block;
  font-size:32px;
  color:#f4c998;
}

.venue span{
  font-size:20px;
  letter-spacing:3px;
  color:#eadbd1;
}

.title{
  font-size:15px;
  letter-spacing:3px;
  margin-bottom:15px;
  opacity:.8;
}

.countdown{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.box{
  padding:18px 5px;
  border-radius:15px;
  border:1px solid rgba(244,201,149,.4);
  background:rgba(255,255,255,.05);
}

.number{
  display:block;
  direction:ltr;
  font-size:clamp(30px,7vw,50px);
  color:#ffe1bc;
  font-weight:bold;
}

.label{
  display:block;
  margin-top:8px;
  font-size:14px;
  color:#ddd0c8;
}

.footer{
  margin-top:28px;
  font-size:21px;
  color:#efc5b7;
  font-style:italic;
}

@media(max-width:520px){

  .card{
    padding:35px 12px 28px;
  }

  .kicker{
    font-size:13px;
    letter-spacing:3px;
  }

  .countdown{
    gap:6px;
  }

  .box{
    padding:16px 3px;
  }

  .label{
    font-size:11px;
  }

}
</style>
</head>

<body>

<div class="card">

  <div class="kicker">
    THE WEDDING OF
  </div>

  <div class="names">
    Ahmed <span>&amp;</span> Anhar
  </div>

  <div class="line"></div>

  <div class="date">
    Saturday | 26 / 9 / 2026
  </div>

  <div class="venue">
    <strong>Grand View</strong>
    <span>Tanta</span>
  </div>

  <div class="title" id="title">
    COUNTDOWN TO OUR SPECIAL DAY
  </div>

  <div class="countdown">

    <div class="box">
      <span class="number" id="days">0</span>
      <span class="label">Days</span>
    </div>

    <div class="box">
      <span class="number" id="hours">0</span>
      <span class="label">Hours</span>
    </div>

    <div class="box">
      <span class="number" id="minutes">0</span>
      <span class="label">Minutes</span>
    </div>

    <div class="box">
      <span class="number" id="seconds">0</span>
      <span class="label">Seconds</span>
    </div>

  </div>

  <div class="footer">
    The best is yet to come ♡
  </div>

</div>

<script>

/*
  موعد الفرح:
  السبت 26 سبتمبر 2026
  الساعة 5:00 مساءً
  بتوقيت مصر (+03:00)
*/

const weddingDate =
  new Date("2026-09-26T17:00:00+03:00").getTime();


function updateCountdown(){

  const now = new Date().getTime();

  const distance = weddingDate - now;


  // لو الموعد وصل
  if(distance <= 0){

    document.getElementById("days").innerHTML = "0";
    document.getElementById("hours").innerHTML = "0";
    document.getElementById("minutes").innerHTML = "0";
    document.getElementById("seconds").innerHTML = "0";

    document.getElementById("title").innerHTML =
      "TODAY IS THE SPECIAL DAY ❤️";

    return;
  }


  const days =
    Math.floor(distance / (1000 * 60 * 60 * 24));


  const hours =
    Math.floor(
      (distance % (1000 * 60 * 60 * 24))
      / (1000 * 60 * 60)
    );


  const minutes =
    Math.floor(
      (distance % (1000 * 60 * 60))
      / (1000 * 60)
    );


  const seconds =
    Math.floor(
      (distance % (1000 * 60))
      / 1000
    );


  document.getElementById("days").innerHTML = days;

  document.getElementById("hours").innerHTML =
    String(hours).padStart(2,"0");

  document.getElementById("minutes").innerHTML =
    String(minutes).padStart(2,"0");

  document.getElementById("seconds").innerHTML =
    String(seconds).padStart(2,"0");

}


// تشغيل أول مرة
updateCountdown();

// تحديث كل ثانية
setInterval(updateCountdown,1000);

</script>

</body>
</html>
